# Для доступа к базе PostgreSQL
POSTGRES_USER=cz
POSTGRES_PASSWORD=cz
POSTGRES_DB=litekiz

# Для шифрования ключей площадок и ГИС МТ в базе
APP_SECRET=change-me-in-production

# Для заполнения пустой базы демо-данными при запуске
DEMO_SEED_ON_START=true

# Для оценки замороженных денег: цена одного кода маркировки, ₽
CODE_PRICE=0.61

# Для открытия интерфейса в браузере
WEB_PORT=8080
